# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.local

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
*.tsbuildinfo

# Runtime Locks, Backups & Temporary Data
data/locks/*
!data/locks/.gitkeep
data/backups/*
!data/backups/.gitkeep
data/documents/secrets/
data/dbf/*.TMP
data/dbf/*.wal
data/dbf/.instance.lock

# Logs
logs/*
!logs/.gitkeep
*.log

# IDE & Tooling
.vscode/
.idea/
.superpowers/
